{
  "name": "kinti-bff",
  "version": "1.0.0",
  "description": "Backend for Frontend de Kinti: auth, cuentas, personalización (SDUI), notificaciones, micro-apps y fault injection",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "check": "node --check src/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "firebase-admin": "^13.0.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
